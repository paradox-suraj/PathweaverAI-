# PathWeaver AI Environment Configuration
# Copy this file to .env and configure for your local/production environment

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/pathweaver?schema=public"

# ── Redis / Queue Storage ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Authentication (NextAuth.js v5) ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-key"
NEXTAUTH_SECRET="your-auth-secret-key"

# Google OAuth Credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ── AI Model Providers ─────────────────────────────────────────────────────
# Primary provider (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"

# Optional alternative providers
OPENAI_API_KEY="your-openai-api-key"
GROQ_API_KEY="your-groq-api-key"
MISTRAL_API_KEY="your-mistral-api-key"

# ── YouTube Data API v3 ───────────────────────────────────────────────────
# Supports comma-separated keys for automatic round-robin rotation
YOUTUBE_API_KEY="your-primary-youtube-api-key"

# ── Security & Auditing ────────────────────────────────────────────────────
# Secret for HMAC cryptographic signing of audit logs and ledger transactions
AUDIT_SECRET="your-high-entropy-audit-signing-secret"
ENCRYPTION_KEY="your-32-byte-hex-encryption-key"

# ── Payment & Marketplace (Razorpay) ───────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecret"
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourKeyId"

# ── Telemetry & Monitoring ─────────────────────────────────────────────────
# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Sentry Error Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
